# Template only. Supply a pull-only registry credential outside Git.
# AKS kubelet AcrPull for application images does not authenticate Argo CD's Helm client.
apiVersion: v1
kind: Secret
metadata:
  name: demoapp-acr
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repo-creds
stringData:
  type: helm
  url: REGISTRY.azurecr.io/charts
  enableOCI: 'true'
  username: REPLACE_WITH_PULL_IDENTITY
  password: REPLACE_WITH_PULL_CREDENTIAL
